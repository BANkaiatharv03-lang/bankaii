:root {
  color-scheme: dark;
  --background: #09090b;
  --surface: #15151a;
  --text: #f7f7f8;
  --muted: #a4a4ae;
  --accent: #c5ff4a;
  --accent-dark: #101300;
  --border: rgba(255, 255, 255, 0.12);
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  background:
    radial-gradient(circle at 20% 15%, rgba(197, 255, 74, 0.12), transparent 30rem),
    var(--background);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
}

.hero,
.video-page {
  width: min(100% - 3rem, 960px);
  margin: 0 auto;
}

.hero {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
}

.video-page {
  padding: 3rem 0 5rem;
}

.eyebrow {
  margin: 0 0 1rem;
  color: var(--accent);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
}

h1 {
  margin: 0;
  font-size: clamp(4rem, 13vw, 9rem);
  letter-spacing: -0.08em;
  line-height: 0.9;
}

.video-page h1 {
  margin-bottom: 2.5rem;
  font-size: clamp(3rem, 8vw, 6rem);
}

.intro {
  max-width: 28rem;
  margin: 1.75rem 0 2.5rem;
  color: var(--muted);
  font-size: 1.1rem;
  line-height: 1.6;
}

.button,
.source-link {
  display: inline-flex;
  align-items: center;
  gap: 0.8rem;
  color: var(--accent-dark);
  background: var(--accent);
  border-radius: 999px;
  font-weight: 700;
  text-decoration: none;
  transition: transform 160ms ease, box-shadow 160ms ease;
}

.button {
  padding: 1rem 1.35rem;
}

.button:hover,
.button:focus-visible {
  transform: translateY(-2px);
  box-shadow: 0 0 2rem rgba(197, 255, 74, 0.25);
}

.back-link {
  display: inline-block;
  margin-bottom: 5rem;
  color: var(--muted);
  text-decoration: none;
}

.back-link:hover,
.back-link:focus-visible,
.source-link:hover,
.source-link:focus-visible {
  color: var(--text);
}

.video-frame {
  overflow: hidden;
  aspect-ratio: 16 / 9;
  border: 1px solid var(--border);
  border-radius: 1rem;
  background: var(--surface);
  box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.35);
}

.video-frame iframe {
  width: 100%;
  height: 100%;
  border: 0;
}

.source-link {
  margin-top: 1.25rem;
  padding: 0.8rem 1.1rem;
  color: var(--text);
  background: transparent;
  border: 1px solid var(--border);
}

@media (max-width: 600px) {
  .hero,
  .video-page {
    width: min(100% - 2rem, 960px);
  }

  .video-page {
    padding-top: 1.5rem;
  }

  .back-link {
    margin-bottom: 4rem;
  }
}
